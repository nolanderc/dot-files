// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "file_finder": {
    "modal_max_width": "medium",
  },
  "disable_ai": true,
  "inlay_hints": {
    "enabled": false,
  },
  "use_auto_surround": false,
  "use_autoclose": false,
  "preferred_line_length": 100,
  "gutter": {
    "min_line_number_digits": 4,
  },
  "colorize_brackets": false,
  "auto_signature_help": true,
  "show_signature_help_after_edits": true,
  "snippet_sort_order": "bottom",
  "show_edit_predictions": false,
  "edit_predictions": {
    "ollama": {
      "prompt_format": "zeta",
      "model": "gemma4:26b",
    },
    "provider": "zed",
  },
  "soft_wrap": "editor_width",
  "autosave": "on_focus_change",
  "go_to_definition_fallback": "find_all_references",
  "agent_ui_font_size": 14.0,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": false,
      "padding": 20,
      "min_column": 100,
      "delay_ms": 0,
      "enabled": true,
    },
  },
  "search": {
    "center_on_match": false,
  },
  "use_smartcase_search": true,
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": [],
  },
  "project_panel": {
    "dock": "left",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
  },
  "cli_default_open_behavior": "existing_window",
  "buffer_line_height": "comfortable",
  "buffer_font_family": "ComicCode Nerd Font",
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
    "copy_on_select": true,
    "blinking": "off",
    "show_count_badge": false,
    "font_family": "ComicCode Nerd Font",
    "flexible": true,
    "dock": "right",
  },
  "vim": {
    "use_smartcase_find": true,
    "use_system_clipboard": "on_yank",
  },
  "vim_mode": true,
  "ui_font_size": 14.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark Soft",
  },
  "theme_overrides": {
    "Gruvbox Dark Soft": {
      "syntax": {
        "keyword": {
          "font_weight": 800,
        },
        "function": {
          "color": "#A3C5B8",
        },
        "function.kwargs": {
          "color": "#EBDBB2",
        },
        "punctuation.delimiter": {
          "color": "#A89984",
        },
        // TODO, WIP, MAYBE
        "constant.comment": {
          "color": "#889964",
          "font_weight": 800,
        },
        // INFO, NOTE, XXX, DOCS, PERF, TEST
        "string.comment": {
          "color": "#887984",
          "font_weight": 800,
        },
        // WARN, HACK, WARNING, FIX, SAFETY
        "keyword.comment": {
          "color": "#C8A954",
          "font_weight": 800,
        },
        // ERROR, FIXME, BUG, DELETE
        "property.comment": {
          "color": "#C87954",
          "font_weight": 800,
        },
      },
    },
  },
  "languages": {
    "JSON": {
      "tab_size": 4,
    },
    "Markdown": {
      "show_edit_predictions": true,
    },
    "Rust": {
      "preferred_line_length": 120,
      "show_edit_predictions": true,
    },
    "Starlark": {
      "formatter": {
        "external": {
          "command": "buildifier",
          "arguments": ["--mode=fix", "--lint=fix", "--warnings=all", "--path={buffer_path}"],
        },
      },
    },
  },
}
